   "updated": 1,
   "link": null,
   "locked": false,
   "text": "InMemorySagaService keeps this in the JVM heap: a crash mid-saga loses it, so nothing compensates.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "InMemorySagaService keeps this in the JVM heap: a crash mid-saga loses it, so nothing compensates.",
